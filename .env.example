# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # Server-only, never expose to client

# Anthropic — use TIDE_ANTHROPIC_API_KEY (not ANTHROPIC_API_KEY) to avoid
# being shadowed by the empty value Claude for Desktop injects into macOS env.
TIDE_ANTHROPIC_API_KEY=          # Server-only

# App
NEXT_PUBLIC_APP_URL=             # https://your-app.vercel.app (or http://localhost:3000)

# ANZ automatic imports — see docs/anz-setup.md; keep scheduling disabled until the first import is checked.
# Server-only. Never put these in NEXT_PUBLIC_ variables or preview environments.
# Akahu Personal App credentials belong to one bank user; explicitly bind their Tide identity.
# Production setup/manual sync are available with the scheduled job disabled.
BANK_SYNC_ENABLED=false
AKAHU_APP_TOKEN=
AKAHU_USER_TOKEN=
AKAHU_OWNER_USER_ID=
AKAHU_HOUSEHOLD_ID=
CRON_SECRET=
# VERCEL_ENV is set by Vercel; only production permits bank requests.
